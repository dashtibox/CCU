[Unit]
Description=VIS live ChargeBridge and ACDC status display
After=systemd-udev-trigger.service
Conflicts=vis-display-hello.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
ExecStartPre=/bin/sh -c 'for attempt in $(seq 1 30); do test -c /dev/spidev0.0 && test -d /sys/class/gpio/gpiochip515 && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/python3 /usr/local/bin/vis-display-status.py
Restart=on-failure
RestartSec=10
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
